+//! Spur mask for the spectrum sent to clients.
+//!
+//! The receiver of a Pluto-class board picks up harmonics of the board's own
+//! clocks as narrow lines, and the LO leaks through at the centre bin. On a
+//! Fishball 7010 the lines measured with a terminated input were harmonics of
+//! 25 MHz (about +20 ppm off nominal) and of 100/3 MHz (about +5 ppm off).
+//! The mask replaces those bins with the level of their surroundings, so the
+//! waterfall, spectrum and anything that reads `/waterfall` no longer shows
+//! them. It only changes the displayed spectrum, not the IQ samples.
+//!
+//! A line is masked only if it is within [`PPM`] of a clock harmonic, stands at
+//! least [`RATIO_DB`] above its surroundings and is at most [`MAX_WIDTH`] bins
+//! wide at half height, so real signals (wider, or not at a harmonic) are left
+//! alone. A real narrow carrier exactly on a harmonic would be hidden too.
+
+use std::cmp::Ordering;
+
+/// Board clocks whose harmonics leak into the receiver, in Hz.
+const CLOCKS_HZ: [f64; 2] = [25e6, 100e6 / 3.0];
+/// Search window around each nominal harmonic, as a fraction of its frequency.
+const PPM: f64 = 50e-6;
+/// A line must stand at least this far above its surroundings (power ratio of 8 dB).
+const RATIO: f32 = 6.309_573;
+/// A line wider than this many bins at half height (in dB) is a signal, not a spur.
+const MAX_WIDTH: usize = 5;
+
+fn median(v: &mut [f32]) -> f32 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap_or(Ordering::Equal));
+    let n = v.len();
+    if n % 2 == 1 {
+        v[n / 2]
+    } else {
+        0.5 * (v[n / 2 - 1] + v[n / 2])
+    }
+}
+
+/// Median level of the bins around `p`, skipping the six bins either side.
+fn reference(b: &[f32], p: usize) -> Option<f32> {
+    let lo = p.saturating_sub(24);
+    let hi = (p + 25).min(b.len());
+    let mut r = Vec::with_capacity(48);
+    r.extend_from_slice(&b[lo..p.saturating_sub(6).max(lo)]);
+    r.extend_from_slice(&b[(p + 7).min(hi)..hi]);
+    if r.len() < 8 { None } else { Some(median(&mut r)) }
+}
+
+/// Extent `(first, last, reference)` to replace if the peak at `p` is a spur.
+fn spur_extent(b: &[f32], p: usize) -> Option<(usize, usize, f32)> {
+    let reference = reference(b, p)?;
+    if reference <= 0.0 {
+        return None;
+    }
+    let peak = b[p];
+    if peak < reference * RATIO {
+        return None;
+    }
+    // Half the excess in dB, but never more than 10 dB below the peak: a strong
+    // line has wide skirts that would otherwise make it look like a signal.
+    let half = (reference * (peak / reference).sqrt()).max(peak * 0.1);
+    let (mut l, mut r) = (p, p);
+    while l > 0 && b[l - 1] >= half {
+        l -= 1;
+    }
+    while r + 1 < b.len() && b[r + 1] >= half {
+        r += 1;
+    }
+    if r - l + 1 > MAX_WIDTH {
+        return None;
+    }
+    let threshold = reference * 2.5;
+    while l + 6 > p && l > 0 && b[l - 1] > threshold {
+        l -= 1;
+    }
+    while r < p + 6 && r + 1 < b.len() && b[r + 1] > threshold {
+        r += 1;
+    }
+    Some((l.saturating_sub(1), (r + 1).min(b.len() - 1), reference))
+}
+
+/// Masks the spurs in `spectrum`, a spectrum as sent on `/waterfall`: element 0
+/// is metadata and the rest are power bins centred on `fc` Hz with a span of
+/// `fs` Hz. Returns the number of bins that were replaced.
+pub fn apply(spectrum: &mut [f32], fc: f64, fs: f64) -> usize {
+    if spectrum.len() < 128 || !(fs > 0.0) {
+        return 0;
+    }
+    let hz = fs / spectrum.len() as f64;
+    let bins = &mut spectrum[1..];
+    let n = bins.len();
+    let c = n / 2;
+
+    // Candidates are located on the unmasked spectrum, then masked in turn.
+    let mut candidates: Vec<usize> = Vec::new();
+    for f0 in CLOCKS_HZ {
+        let k0 = ((fc - 0.48 * fs) / f0).ceil().max(1.0) as i64;
+        let k1 = ((fc + 0.48 * fs) / f0).floor() as i64;
+        for k in k0..=k1 {
+            let f = k as f64 * f0;
+            let idx = c as i64 + ((f - fc) / hz).round() as i64;
+            let w = ((PPM * f / hz).ceil() as i64 + 1).max(2);
+            if idx - w - 24 < 0 || idx + w + 24 >= n as i64 {
+                continue;
+            }
+            let (lo, hi) = ((idx - w) as usize, (idx + w) as usize);
+            let mut p = lo;
+            for i in lo..=hi {
+                if bins[i] > bins[p] {
+                    p = i;
+                }
+            }
+            candidates.push(p);
+        }
+    }
+
+    let mut replaced = 0;
+    // The LO leaks through at the centre bin: always smooth it over.
+    if c >= 2 {
+        if let Some(r) = reference(bins, c).filter(|&r| r > 0.0) {
+            bins[c - 2..=c + 2].fill(r);
+            replaced += 5;
+        }
+    }
+    for p in candidates {
+        if let Some((l, r, reference)) = spur_extent(bins, p) {
+            bins[l..=r].fill(reference);
+            replaced += r - l + 1;
+        }
+    }
+    replaced
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const FS: f64 = 20.72e6;
+    const FC: f64 = 870e6;
+
+    /// Flat noise-like floor with a little deterministic ripple.
+    fn floor() -> Vec<f32> {
+        (0..4096).map(|i| 1.0 + 0.05 * ((i * 7 % 13) as f32 / 13.0 - 0.5)).collect()
+    }
+
+    fn bin_of(f: f64) -> usize {
+        1 + 2047 + ((f - FC) / (FS / 4096.0)).round() as usize
+    }
+
+    #[test]
+    fn masks_a_harmonic_spur() {
+        let mut s = floor();
+        let k = bin_of(875.0e6 * (1.0 + 20e-6));
+        s[k - 1] = 8.0;
+        s[k] = 60.0;
+        s[k + 1] = 9.0;
+        apply(&mut s, FC, FS);
+        assert!(s[k - 3..=k + 3].iter().all(|&v| v < 1.2), "{:?}", &s[k - 3..=k + 3]);
+    }
+
+    #[test]
+    fn masks_a_strong_spur_with_wide_skirts() {
+        // 40 dB line seen on the antenna: skirts of 29, 37, 38, 32, 18 dB above the floor
+        let mut s = floor();
+        let k = bin_of(875.0e6 * (1.0 + 20e-6));
+        for (i, db) in [(-5i32, 13.0f32), (-4, 18.0), (-3, 29.0), (-2, 37.0), (-1, 38.0), (0, 40.0), (1, 38.0), (2, 32.0), (3, 18.0), (4, 13.0)] {
+            s[(k as i32 + i) as usize] = 10f32.powf(db / 10.0);
+        }
+        apply(&mut s, FC, FS);
+        assert!(s[k - 7..=k + 7].iter().all(|&v| v < 1.2), "{:?}", &s[k - 7..=k + 7]);
+    }
+
+    #[test]
+    fn leaves_a_wide_signal_on_a_harmonic() {
+        let mut s = floor();
+        let k = bin_of(866.667e6);
+        for i in k - 20..k + 20 {
+            s[i] = 12.0;
+        }
+        let before = s.clone();
+        apply(&mut s, FC, FS);
+        assert_eq!(&s[k - 20..k + 20], &before[k - 20..k + 20]);
+    }
+
+    #[test]
+    fn leaves_a_narrow_line_away_from_the_harmonics() {
+        let mut s = floor();
+        let k = bin_of(871.9e6);
+        s[k] = 60.0;
+        apply(&mut s, FC, FS);
+        assert_eq!(s[k], 60.0);
+    }
+
+    #[test]
+    fn smooths_the_lo_bin_and_keeps_the_metadata() {
+        let mut s = floor();
+        s[0] = 3.0;
+        s[2048] = 40.0;
+        apply(&mut s, FC, FS);
+        assert_eq!(s[0], 3.0);
+        assert!(s[2048] < 1.2);
+    }
+
+    #[test]
+    fn ignores_a_degenerate_spectrum() {
+        let mut s = vec![0.0f32; 4096];
+        assert_eq!(apply(&mut s, FC, FS), 0);
+        assert_eq!(apply(&mut [1.0; 8], FC, FS), 0);
+    }
+}
