CONFIG_DEBUG_ZYNQ_UART1=y
CONFIG_MACB=y
# Tickless idle and a 250 Hz tick. The kernel default here (periodic tick, HZ=1000) wakes each core 1000 times a second even
# when it is idle: about 2150 timer interrupts a second on an otherwise idle radio.
# CONFIG_HZ_PERIODIC is not set
CONFIG_NO_HZ_IDLE=y
# CONFIG_HZ_1000 is not set
CONFIG_HZ_250=y
